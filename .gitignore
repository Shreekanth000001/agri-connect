backend/.venv/

# Python cache
backend/**/__pycache__/
backend/**/*.py[cod]

# Tool caches
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Logs
backend/*.log

# Local backend env
backend/.env

# IDE
.vscode/
.idea/