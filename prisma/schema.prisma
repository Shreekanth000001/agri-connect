generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Define the Enum options
enum Role {
  FARMER
  BUYER
}

model User {
  uid       Int              @id @default(autoincrement())
  uname     String
  uemail    String           @unique
  password  String           @default("")
  uphone    Int
  ugeo      String
  uloc      String           @default("")
  role      Role             @default(FARMER)
  ujoinedAt DateTime         @default(now())
  bids_cid  BidId[]          @relation("cidRelation")
  bids_fid  BidId[]          @relation("fidRelation")
  prod_fid  ProductAuction[] @relation("ProdFidRelation")
}

enum AuctionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum Category {
  VEGETABLES
  FRUITS
  GRAINS
  DAIRY
  MEAT
  FISH
  OTHER
}

model ProductAuction {
  ProdAucId     Int           @id @default(autoincrement())
  fid           Int
  title         String
  description   String
  startingBid   Float
  startTime     DateTime      @default(now())
  endTime       DateTime
  auctionStatus AuctionStatus @default(OPEN)
  category      Category      @default(OTHER)
  imageUrl      String        @default("")
  CreatedAt     DateTime      @default(now())
  user_fid      User          @relation("ProdFidRelation", fields: [fid], references: [uid])
  auc_bid       BidId[]       @relation("bidRelation")
}

enum Status {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  FAILED
}

model BidId {
  bidId        Int            @id @default(autoincrement())
  aucId        Int
  cid          Int
  fid          Int
  bidAmount    Float
  bidTime      DateTime       @default(now())
  deliveryDate DateTime
  status       Status         @default(PENDING)
  ujoinedAt    DateTime       @default(now())
  user_cid     User           @relation("cidRelation", fields: [cid], references: [uid])
  user_fid     User           @relation("fidRelation", fields: [fid], references: [uid])
  auc_bid      ProductAuction @relation("bidRelation", fields: [aucId], references: [ProdAucId])
}
